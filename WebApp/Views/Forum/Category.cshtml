@using Domain
@model ForumCategory

<div class="max-w-5xl mx-auto py-10">

    <h1 class="text-3xl font-bold mb-6">
        @(Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName == "fa"
            ? Model.NameFa : Model.NameEn)
    </h1>

    <a asp-action="CreateTopic" asp-route-categoryId="@Model.Id"
       class="px-4 py-2 bg-blue-600 text-white rounded mb-6 inline-block">
        ایجاد تاپیک جدید / New Topic
    </a>

    <div class="space-y-4">
        @foreach (var t in Model.Topics.OrderByDescending(x => x.CreatedAt))
        {
            <a asp-action="Topic" asp-route-slug="@t.Slug"
               class="block bg-white dark:bg-gray-900 p-4 rounded-lg shadow border dark:border-gray-800">

                <h2 class="text-xl font-semibold">@t.Title</h2>
                <p class="text-gray-500 dark:text-gray-400 text-sm">
                    توسط @t.User.UserName — @t.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                </p>
            </a>
        }
    </div>
</div>
