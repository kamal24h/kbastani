@using DataAccess.Dtos
@using Microsoft.AspNetCore.Mvc.Localization
@model TagDto
@inject IHtmlLocalizer<SharedResource> Localizer

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1 class="text-2xl font-bold mb-6">@Localizer["EditTags"]</h1>

<form asp-action="Update" method="post" class="space-y-6">

    <input type="hidden" asp-for="TagId" />

    <div class="p-4 rounded shadow">
        <label class="block mb-1">نام فارسی</label>
        <input asp-for="NameFa" class="w-full border p-2 rounded" />
    </div>

    <div class="p-4 rounded shadow">
        <label class="block mb-1">English Name</label>
        <input asp-for="NameEn" class="w-full border p-2 rounded" />
    </div>

    <div class="p-4 rounded shadow">
        <label class="block mb-1">@Localizer["Slug"]</label>
        <input asp-for="Slug" class="w-full border p-2 rounded" />
    </div>

    <button class="bg-blue-600 text-white px-4 py-2 rounded">
        @Localizer["Save"]
    </button>

</form>
