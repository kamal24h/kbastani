@using DataAccess.Dtos
@model ProjectDto
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SharedResource> Localizer

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="max-w-4xl mx-auto py-8">

    <h1 class="text-2xl font-bold mb-6">@Localizer["EditResumeProject"]</h1>

    <form asp-action="Edit" method="post" class="space-y-6 bg-white dark:bg-gray-900 p-6 rounded-lg shadow border dark:border-gray-800">

        <input type="hidden" asp-for="ProjectId" />

        <div>
            <label class="block mb-1 font-medium">@Localizer["TitleFa"]</label>
            <input asp-for="TitleFa"
                   class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-700
                          bg-gray-50 dark:bg-gray-800 focus:ring-2 focus:ring-blue-500 outline-none" />
            <span asp-validation-for="TitleFa" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label class="block mb-1 font-medium">@Localizer["TitleEn"]</label>
            <input asp-for="TitleEn"
                   class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-700
                          bg-gray-50 dark:bg-gray-800 focus:ring-2 focus:ring-blue-500 outline-none" />
            <span asp-validation-for="TitleEn" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label class="block mb-1 font-medium">@Localizer["DescriptionFa"]</label>
            <textarea asp-for="DescriptionFa" rows="6"
                      class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-700
                             bg-gray-50 dark:bg-gray-800 focus:ring-2 focus:ring-blue-500 outline-none"></textarea>
            <span asp-validation-for="DescriptionFa" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label class="block mb-1 font-medium">@Localizer["DescriptionEn"]</label>
            <textarea asp-for="DescriptionEn" rows="6"
                      class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-700
                             bg-gray-50 dark:bg-gray-800 focus:ring-2 focus:ring-blue-500 outline-none"></textarea>
            <span asp-validation-for="DescriptionEn" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label class="block mb-1 font-medium">@Localizer["ProjectUrl"]</label>
            <input asp-for="ProjectUrl"
                   class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-700
                          bg-gray-50 dark:bg-gray-800 focus:ring-2 focus:ring-blue-500 outline-none" />
            <span asp-validation-for="ProjectUrl" class="text-red-500 text-sm"></span>
        </div>

        <button type="submit"
                class="px-6 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg">
            @Localizer["Submit"]
        </button>
    </form>
</div>