@using Domain
@model Education

<div class="max-w-4xl mx-auto py-8">

    <h1 class="text-2xl font-bold mb-6">ویرایش تحصیلات / Edit Education</h1>

    <form asp-action="Edit" method="post"
          class="space-y-6 bg-white dark:bg-gray-900 p-6 rounded-lg shadow border dark:border-gray-800">

        <input type="hidden" asp-for="EducationId" />

        <div>
            <label class="block mb-1 font-medium">مدرک / Degree</label>
            <input asp-for="DegreeEn"
                   class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-700
                          bg-gray-50 dark:bg-gray-800 focus:ring-2 focus:ring-blue-500 outline-none" />
            <span asp-validation-for="DegreeEn" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label class="block mb-1 font-medium">مؤسسه / Institution</label>
            <input asp-for="UniversityEn"
                   class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-700
                          bg-gray-50 dark:bg-gray-800 focus:ring-2 focus:ring-blue-500 outline-none" />
            <span asp-validation-for="UniversityEn" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label class="block mb-1 font-medium">سال / Year</label>
            <input asp-for="StartDate"
                   class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-700
                          bg-gray-50 dark:bg-gray-800 focus:ring-2 focus:ring-blue-500 outline-none" />
            <span asp-validation-for="StartDate" class="text-red-500 text-sm"></span>
        </div>

        <button type="submit"
                class="px-6 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg">
            ذخیره تغییرات / Save Changes
        </button>
    </form>
</div>
