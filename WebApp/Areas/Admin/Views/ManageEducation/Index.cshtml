@using Domain
@model IEnumerable<Education>

<div class="max-w-6xl mx-auto py-8">

    <h1 class="text-2xl font-bold mb-6">مدیریت تحصیلات / Resume Education</h1>

    <table class="min-w-full bg-white dark:bg-gray-900 border dark:border-gray-800">
        <thead class="bg-gray-100 dark:bg-gray-800">
            <tr>
                <th class="px-4 py-2 text-left">مدرک / Degree</th>
                <th class="px-4 py-2 text-left">مؤسسه / Institution</th>
                <th class="px-4 py-2 text-left">سال / Year</th>
                <th class="px-4 py-2 text-left">عملیات / Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr class="border-t dark:border-gray-800">
                    <td class="px-4 py-2">@item.DegreeEn</td>
                    <td class="px-4 py-2">@item.DegreeFa</td>
                    <td class="px-4 py-2">@item.UniversityEn</td>
                    <td class="px-4 py-2">@item.UniversityFa</td>
                    <td class="px-4 py-2">@item.StartDate</td>
                    <td class="px-4 py-2">@item.EndDate</td>
                    <td class="px-4 py-2">@item.DescriptionEn</td>
                    <td class="px-4 py-2">@item.DescriptionFa</td>

                    <td class="px-4 py-2">
                        <a asp-action="Edit" asp-route-id="@item.EducationId"
                           class="px-3 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded">
                            ✏️ ویرایش / Edit
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
